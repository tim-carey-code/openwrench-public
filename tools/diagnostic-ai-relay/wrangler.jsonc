{
  "name": "openwrench-diagnostic-ai-relay",
  "main": "relay.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "ANALYZE_LIMIT",
      "namespace_id": "1",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_QUOTA",
        "class_name": "DailyQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DailyQuota"
      ]
    }
  ]
}
